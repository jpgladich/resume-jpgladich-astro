---
title: "My Projects"
description: "This is the Projects section"

import Section from "../Section.astro"

import { projects } from "@cv"
---

<Section title="Proyectos">
  <ul>
    {
      projects.map(
        ({ description, name }, index) => {
          return (
            <li key={name}>
              <h3>{name}</h3>
              <p>{description}</p>
              {index < projects.length - 1 && <hr />}
            </li>
          )
        }
      )
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 0;
    list-style: none;
    padding: 0;
  }

  li {
    margin-bottom: 16px;
  }

  li:last-child {
    margin-bottom: 0;
  }

  h3 {
    font-size: 1rem;
    font-weight: 600;
    color: #111;
    margin: 0 0 8px 0;
  }

  p {
    font-size: 0.9rem;
    color: #444;
    margin: 0 0 16px 0;
    line-height: 1.5;
  }

  hr {
    border: none;
    border-top: 1px solid #ddd;
    margin: 0 0 16px 0;
  }
</style>
