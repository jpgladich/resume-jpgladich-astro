---
title: "My Skills"
description: "This is the skills file"

import Section from "../Section.astro"

import { skill } from "@cv"
const { groups } = skill

---

<Section title="Tecnologías y Herramientas">
  {groups.map((group: { name: string; items: string[] }) => (
    <div class="skill-group">
      <h3>{group.name}</h3>
      <ul class="skills-list">
        {group.items.map((item: string) => <li>{item}</li>)}
      </ul>
    </div>
  ))}
</Section>

<style>
  .skill-group {
    margin-bottom: 16px;
  }

  h3 {
    font-size: 0.9rem;
    font-weight: 600;
    margin: 0 0 8px 0;
    color: #333;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 4px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    align-items: center;
    color: #444;
    display: flex;
    font-size: 0.9rem;
    font-weight: 400;
    gap: 8px;
    padding: 0;
    margin: 0;
    padding-left: 1.2em;
    position: relative;
  }

  li::before {
    content: "•";
    color: #666;
    position: absolute;
    left: 0;
  }
</style>
