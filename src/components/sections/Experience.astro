---
title: "My Experience"
description: "This is the experience"

import Section from "../Section.astro"
import { work } from "@cv"
---
<p></p>
<Section title="Experiencia profesional">
  <ul>
    {
      work.map(({ name, startDate, endDate, position, summary, highlights, achievements, technologies, url }: { name: string, startDate: string, endDate: string | null, position: string, summary: string, highlights?: string[], achievements?: string[], technologies?: string[], url?: string }) => {
        const startYear = startDate;
        const endYear = endDate ?? "Actualidad";

        return (
          <li key={name}>
            <article>
              <header>
                <div>
                  <h3>
                    {url ? (
                      <a href={url} title={`Ver ${name}`} target="_blank">
                        {name}
                      </a>
                    ) : (
                      name
                    )}
                  </h3>
                  <h4>{position}</h4>
                </div>
                <div>
                  <time dateTime={startDate}>{startYear}</time> – <time dateTime={endDate ?? undefined}>{endYear}</time>
                </div>
              </header>

              <p>{summary}</p>

              {highlights && highlights.length > 0 && (
                <div class="highlights">
                  <h5>Principales responsabilidades</h5>
                  <ul class="highlights-list">
                    {highlights.map((h: string) => <li>{h}</li>)}
                  </ul>
                </div>
              )}

              {achievements && achievements.length > 0 && (
                <div class="highlights">
                  <h5>Logros destacados</h5>
                  <ul class="highlights-list">
                    {achievements.map((a: string) => <li>{a}</li>)}
                  </ul>
                </div>
              )}

              {technologies && technologies.length > 0 && (
                <div class="technologies">
                  <h5>Tecnologías</h5>
                  <p class="tech-list">{technologies.join(" • ")}</p>
                </div>
              )}
            </article>
          </li>
        )
      })
    }
  </ul>
</Section>



<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
    list-style: none;
    padding: 0;
  }

  li {
    list-style: none;
  }

  article h3 {
    font-size: 1rem;
    font-weight: 600;
    color: #111;
    margin: 0 0 4px 0;
  }

  article a {
    color: #111;
    text-decoration: none;
  }

  article a:hover {
    text-decoration: underline;
  }

  article h4 {
    font-size: 0.9rem;
    color: #444;
    font-weight: 500;
    margin: 0 0 8px 0;
  }

  article p {
    color: #444;
    font-size: 0.9rem;
    margin: 0 0 12px 0;
    line-height: 1.5;
  }

  .highlights {
    margin-top: 12px;
  }

  .highlights h5,
  .technologies h5 {
    font-size: 0.8rem;
    font-weight: 600;
    color: #333;
    margin: 0 0 8px 0;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .highlights-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-left: 0;
    margin: 0;
  }

  .highlights-list li {
    font-size: 0.9rem;
    color: #444;
    list-style: none;
    padding-left: 1.2em;
    position: relative;
    line-height: 1.4;
  }

  .highlights-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: #666;
  }

  .technologies {
    margin-top: 12px;
  }

  .tech-list {
    font-size: 0.9rem;
    color: #555;
    margin: 0;
    line-height: 1.4;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 16px;
  }

  time {
    color: #777;
    font-size: 0.85rem;
    min-width: 120px;
    text-align: right;
    cursor: default;
    flex-shrink: 0;
  }

  @media (max-width: 700px) {
    header {
      flex-direction: column;
      align-items: flex-start;
    }

    time {
      text-align: left;
    }
  }
</style>
