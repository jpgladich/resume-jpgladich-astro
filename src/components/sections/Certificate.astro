---
title: "My Certificate"
name: "This is the Certificates section"

import Section from "../Section.astro"

import { certificates } from "@cv"
---

<Section title="Certificaciones">
  <ul>
    {
      certificates.map(
        ({ name, date, issuer, url }) => {
          return (
            <li>
              {url ? (
                <a href={url} target="_blank" title={`Ver ${name}`}>
                  {name}
                </a>
              ) : (
                name
              )}
            </li>
          )
        }
      )
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    list-style: none;
    padding: 0;
  }

  li {
    list-style: none;
    padding-left: 1.5em;
    position: relative;
  }

  li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: #666;
  }

  a {
    color: #111;
    text-decoration: none;
    font-size: 0.95rem;
  }

  a:hover {
    text-decoration: underline;
    color: #333;
  }
</style>
